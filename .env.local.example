# Supabase — see docs/CONSTITUCION.md section 7 / rule 11
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. NEVER expose to the client. Used exclusively by
# createAdminSupabaseClient() for strictly administrative server-side
# operations — never in routes/use-cases that serve participants.
SUPABASE_SERVICE_ROLE_KEY=

# Server-only. Selects the LLM backend used by
# src/infrastructure/llm/LlmInterpreter.ts to interpret financial-literacy
# results in /admin/reports: "gemini" (default) or "ollama".
LLM_PROVIDER=gemini

# Used when LLM_PROVIDER=gemini. Optional in development — the feature
# degrades to a placeholder message when unset or the request fails.
GEMINI_API_KEY=

# Used when LLM_PROVIDER=ollama. Point to a locally running Ollama server —
# no API key needed.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b

# Server-only. Used by src/infrastructure/llm/employment/MiniMaxProvider.ts —
# the separate AI engine for the employability module (keywords, CV bullets,
# quality check, outreach messages). A super_admin can also switch it off
# entirely from /admin/employment-ai regardless of these being set.
MINIMAX_API_KEY=
MINIMAX_MODEL=MiniMax-M2.7
